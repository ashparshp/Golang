{{template "base" .}}

{{define "title"}}
    All Sales
{{end}}

{{define "content"}}
    <h2 class="mt-5">All Sales</h2>
    <hr>

    <table id="sales-table" class="table table-striped">
        <thead>
            <tr>
                <th>Transaction</th>
                <th>Customer</th>
                <th>Product</th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>

        </tbody>
    </table>
    <nav aria-label="Page navigation">
        <ul id="pagimator" class="pagination">

        </ul>
    </nav>
{{end}}

{{define "js"}}
<script>

function formatCurrency(amount) {
    let c = parseFloat(amount / 100);
    return c.toLocaleString('en-CA', {
        style: 'currency',
        currency: 'CAD',
    });
}

let currentPage = 1;
let pageSize = 3;

function updatePagination(pageSize, currentPage) {
    let pagimator = document.getElementById("pagimator");
    let html = `<li class="page-item"><a class="page-link pager" href="#" data-page="${currentPage - 1}">&lt;</a></li>`;

    for (let i = 0; i <= pageSize; i++) {
        html += `<li class="page-item"><a class="page-link pager" href="#" data-page="${i + 1}">${i + 1}</a></li>`;
    }

    html += `<li class="page-item"><a class="page-link pager" href="#" data-page="${currentPage + 1}">&gt;</a></li>`;

    pagimator.innerHTML = html;
}

function updateTable(ps, cp) {
    let token = localStorage.getItem("token");
    let tbody = document.getElementById("sales-table").getElementsByTagName("tbody")[0];

    let body = {
       page_size: ps,
       current_page: cp,
    }

    const requestOptions = {
        method: 'post',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token,
        },
        body: JSON.stringify(body),
    }

    fetch("{{.API}}/api/admin/all-sales", requestOptions)
    .then(response => response.json())
    .then(function (salesData) {
        console.log(salesData);

        if (!salesData.orders || salesData.orders.length === 0) {
            let newRow = tbody.insertRow();
            let cell = newRow.insertCell();
            cell.colSpan = 4;
            cell.textContent = "No sales data available.";
            return;
        }

        salesData.orders.forEach(function(sale) {
            let newRow = tbody.insertRow();
            
            // Transaction cell
            let transactionCell = newRow.insertCell();
            transactionCell.innerHTML = `<a href="/admin/sales/${sale.id}">Order ${sale.id}</a>`;

            // Customer cell
            let customerCell = newRow.insertCell();
            let customerName = document.createTextNode(sale.customer.first_name + " " + sale.customer.last_name);
            customerCell.appendChild(customerName);

            // Product cell
            let productCell = newRow.insertCell();
            let productName = document.createTextNode(sale.widget.name);
            productCell.appendChild(productName);

            // Amount cell
            sale.transaction.amount = formatCurrency(sale.transaction.amount);
            let amountCell = newRow.insertCell();
            let amountText = document.createTextNode(sale.transaction.amount);
            amountCell.appendChild(amountText);

            // Status cell
            let statusCell = newRow.insertCell();
            if (sale.status_id === 1) {
                statusCell.innerHTML = `<span class="badge bg-danger">Paid</span>`;
            } else {
                statusCell.innerHTML = `<span class="badge bg-success">Refunded</span>`;
            }
        })
        updatePagination(salesData.last_page, salesData.current_page);
    })
}

document.addEventListener("DOMContentLoaded", function() {
    updateTable(pageSize, currentPage);
});
</script>
{{end}}